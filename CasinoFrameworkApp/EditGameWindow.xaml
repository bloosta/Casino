<Window x:Class="CasinoFrameworkApp.EditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Game" Height="220" Width="350" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Played At:" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <DatePicker Grid.Row="0" Grid.Column="1" x:Name="DatePickerPlayedAt"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Type:" VerticalAlignment="Center" Margin="0,5,5,0"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TextBoxType" Margin="0,5,0,0"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Players (IDs):" VerticalAlignment="Center" Margin="0,5,5,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBoxPlayers" Margin="0,5,0,0"
             ToolTip="Введите через запятую, например: 1,3,4"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="75" Margin="0,0,5,0" Click="OnSave"/>
            <Button Content="Cancel" Width="75" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
