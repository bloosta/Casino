<Window x:Class="CasinoFrameworkApp.EditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Параметры игры" Height="300" Width="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Дата -->
        <Label Grid.Row="0" Grid.Column="0" Content="Дата:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <DatePicker Grid.Row="0" Grid.Column="1"
                x:Name="DatePickerPlayedAt"
                Margin="0,0,0,10"/>

        <!-- Время -->
        <Label Grid.Row="1" Grid.Column="0" Content="Время:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="1" Grid.Column="1"
             x:Name="TextBoxTime"
             Margin="0,0,0,10"
             ToolTip="Введите время в формате ЧЧ:ММ:СС"
             PreviewTextInput="TextBoxTime_PreviewTextInput"
             TextChanged="TextBoxTime_TextChanged"/>

        <!-- Тип игры -->
        <Label Grid.Row="2" Grid.Column="0" Content="Игра:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" 
                 x:Name="TextBoxType" 
                 Margin="0,0,0,10"/>

        <!-- Игроки -->
        <Label Grid.Row="3" Grid.Column="0" Content="Игроки:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox Grid.Row="3" Grid.Column="1" 
                 x:Name="TextBoxPlayers" 
                 Margin="0,0,0,10"
                 ToolTip="Введите ID игроков через запятую"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button Content="Сохранить" 
                    Width="100" 
                    Height="30" 
                    Margin="0,0,10,0" 
                    Click="OnSave"/>
            <Button Content="Отмена" 
                    Width="100" 
                    Height="30" 
                    Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
