<Window x:Class="CasinoFrameworkApp.EditGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Game" Height="300" Width="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Date -->
            <RowDefinition Height="Auto"/>
            <!-- Time -->
            <RowDefinition Height="Auto"/>
            <!-- Type -->
            <RowDefinition Height="Auto"/>
            <!-- Players -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Дата: остался DatePicker с календариком -->
        <Label Grid.Row="0" Grid.Column="0" Content="Date (dd.MM.yyyy):" VerticalAlignment="Center" Margin="0,0,5,0"/>
        <DatePicker Grid.Row="0" Grid.Column="1"
                x:Name="DatePickerPlayedAt"
                Margin="0,0,0,5"/>

        <!-- Время -->
        <Label Grid.Row="1" Grid.Column="0" Content="Time (HH:mm:ss):" VerticalAlignment="Center" Margin="0,5,5,0"/>
        <TextBox Grid.Row="1" Grid.Column="1"
             x:Name="TextBoxTime"
             Margin="0,5,0,5"
             ToolTip="Введите время в формате ЧЧ:ММ:СС"
             PreviewTextInput="TextBoxTime_PreviewTextInput"
             TextChanged="TextBoxTime_TextChanged"/>

        <!-- Тип игры -->
        <Label Grid.Row="2" Grid.Column="0" Content="Type:" VerticalAlignment="Center" Margin="0,5,5,0"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TextBoxType" Margin="0,5,0,5"/>

        <!-- Игроки -->
        <Label Grid.Row="3" Grid.Column="0" Content="Players (IDs):" VerticalAlignment="Center" Margin="0,5,5,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TextBoxPlayers" Margin="0,5,0,10"
             ToolTip="Введите через запятую, например: 1,3,4"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                HorizontalAlignment="Right">
            <Button Content="Save"   Width="75" Margin="0,0,5,0" Click="OnSave"/>
            <Button Content="Cancel" Width="75" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
