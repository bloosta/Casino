<Window x:Class="CasinoFrameworkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CasinoFrameworkApp.ViewModels"
        Title="Casino" Height="450" Width="800"
        xmlns:conv="clr-namespace:CasinoFrameworkApp.Converters">
<Window.Resources>
    <conv:StringToNullableIntConverter x:Key="StrToNullableInt" />
</Window.Resources>
    <!-- DataContext устанавливается в конструкторе MainWindow -->
    <DockPanel>
        <TabControl>

            <!-- Вкладка Клиенты -->
            <TabItem Header="Clients">
                <DockPanel Margin="10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Label Content="Filter:" VerticalAlignment="Center"/>
                        <TextBox Width="150" Margin="5,0"
                     Text="{Binding ClientsVM.Filter, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Refresh"
                    Command="{Binding ClientsVM.RefreshCommand}"
                    Margin="10,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding ClientsVM.Clients}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True"
                    Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"   Binding="{Binding Id}"   Width="50"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✎"
                              Command="{Binding DataContext.ClientsVM.UpdateCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Id}"
                              Width="30" Margin="0,0,5,0"/>
                                            <Button Content="🗑"
                              Command="{Binding DataContext.ClientsVM.DeleteCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Id}"
                              Width="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Add Client"
                  Command="{Binding ClientsVM.CreateCommand}"
                  HorizontalAlignment="Right"
                  Width="100"/>
                </DockPanel>
            </TabItem>

            <!-- Вкладка Игры -->
            <TabItem Header="Games">
                <DockPanel Margin="10">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Label Content="From:" VerticalAlignment="Center"/>
                        <DatePicker SelectedDate="{Binding GamesVM.From}" Width="120" Margin="5,0"/>
                        <Label Content="To:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <DatePicker SelectedDate="{Binding GamesVM.To}" Width="120" Margin="5,0"/>
                        <Label Content="Type:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Text="{Binding GamesVM.TypeFilter, UpdateSourceTrigger=PropertyChanged}"
                     Width="120" Margin="5,0"/>
                        <Label Content="Client ID:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <TextBox Width="50" Margin="5,0"
         Text="{Binding GamesVM.ClientIdFilter,
                Converter={StaticResource StrToNullableInt},
                UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Refresh"
                    Command="{Binding GamesVM.RefreshCommand}"
                    Margin="10,0"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding GamesVM.Games}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"       Binding="{Binding Id}"         Width="50"/>
                            <DataGridTextColumn Header="PlayedAt" Binding="{Binding PlayedAt}"   Width="150"/>
                            <DataGridTextColumn Header="Type"     Binding="{Binding Type}"       Width="150"/>
                            <DataGridTextColumn Header="Players"
                    Binding="{Binding PlayerIdsDisplay}"
                    Width="150"/>

                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="✎"
                Click="OnEditGame_Click"
                Width="30" Margin="0,0,5,0"/>
                                            <Button Content="🗑"
                Command="{Binding DataContext.GamesVM.DeleteCommand,
                          RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding Id}"
                Width="30"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Add Game"
                  Command="{Binding GamesVM.CreateCommand}"
                  DockPanel.Dock="Bottom"
                  HorizontalAlignment="Right"
                  Width="100"
                  Margin="0,10,0,0"/>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
