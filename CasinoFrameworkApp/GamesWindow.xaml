<Window x:Class="CasinoFrameworkApp.GamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Games" Height="400" Width="600">
    <DockPanel Margin="10">
        <!-- Панель фильтров -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
            <Label Content="From:" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding From}" Width="120" Margin="5,0"/>
            <Label Content="To:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker SelectedDate="{Binding To}" Width="120" Margin="5,0"/>
            <Label Content="Type:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Text="{Binding TypeFilter, UpdateSourceTrigger=PropertyChanged}"
               Width="120" Margin="5,0"/>
            <Label Content="Client ID:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox Text="{Binding ClientIdFilter, UpdateSourceTrigger=PropertyChanged}"
               Width="50" Margin="5,0"/>
            <Button Content="Refresh"
              Command="{Binding RefreshCommand}"
              Margin="10,0"/>
        </StackPanel>

        <!-- Таблица игр -->
        <DataGrid ItemsSource="{Binding Games}"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="PlayedAt" Binding="{Binding PlayedAt}" Width="150"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                <DataGridTextColumn Header="Players" 
                            Binding="{Binding PlayerIds}" 
                            Width="150"/>
                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="✎"
                        Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Width="30" Margin="0,0,5,0"/>
                                <Button Content="🗑"
                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding Id}"
                        Width="30"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопка создания -->
        <Button Content="Add Game"
            Command="{Binding CreateCommand}"
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Right"
            Width="100"
            Margin="0,10,0,0"/>
    </DockPanel>
</Window>
